# --- Core ---
DATABASE_URL=sqlite:///./releaselens.db
# For PostgreSQL: postgresql+psycopg2://releaselens:releaselens@localhost:5432/releaselens
SECRET_KEY=change-me-to-a-long-random-string
# Optional: a Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173

# --- LLM (leave empty to run in offline heuristic mode) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- GitHub (optional server-side token to raise rate limits for public repos) ---
GITHUB_TOKEN=

# --- Tuning ---
MAX_COMMITS=100
MAX_DIFF_CHARS_PER_CHANGE=3000
CHROMA_PATH=./chroma_data
RISK_MODEL_PATH=
